{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "put-task-form-setting.schema.json",
  "title": "PutTaskFormSettingSchema",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields"],
  "properties": {
    "fields": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "type", "required", "order", "columnSpan"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "enum": ["text", "date", "datetime", "email"]
          },
          "required": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "columnSpan": {
            "type": "integer",
            "enum": [1, 2]
          },
          "placeholder": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
