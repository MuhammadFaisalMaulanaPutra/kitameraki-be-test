{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "create-task.schema.json",
  "title": "CreateTaskSchema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "status", "priority"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "status": {
      "enum": ["todo", "in_progress", "done"]
    },
    "priority": {
      "enum": ["low", "medium", "high"]
    },
    "dueDate": {
      "type": "string",
      "format": "date-time"
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
