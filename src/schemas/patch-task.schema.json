{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "patch-task.schema.json",
  "title": "PatchTaskSchema",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 5000
    },
    "status": {
      "enum": ["todo", "in_progress", "done"]
    },
    "priority": {
      "enum": ["low", "medium", "high"]
    },
    "dueDate": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "assigneeId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    }
  }
}
