{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task-query.schema.json",
  "title": "TaskQuerySchema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["todo", "in_progress", "done"]
    },
    "priority": {
      "enum": ["low", "medium", "high"]
    },
    "sortBy": {
      "enum": ["createdAt", "updatedAt", "title", "dueDate"]
    },
    "search": {
      "type": "string"
    },
    "sortOrder": {
      "enum": ["asc", "desc"]
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "continuationToken": {
      "type": "string"
    }
  }
}
