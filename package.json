{
  "name": "kitameraki-be-test",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "db:init": "npm run build && node dist/scripts/init-db.js",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "npm run build && node --test dist/test/unit/*.test.js",
    "test:integration": "npm run build && node --test dist/test/integration/*.test.js"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "main": "dist/src/{index.js,functions/*.js}"
}
