{
  "name": "kitameraki-be-test",
  "version": "1.0.0",
  "description": "Task Management API on Azure Functions + Cosmos DB",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "db:init": "node scripts/init-db.mjs",
    "test": "tsc && node --test \"dist/src/**/*.test.js\""
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@azure/cosmos": "^4.10.2",
    "@azure/functions": "^4.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "~5.9.0"
  },
  "main": "dist/src/{index.js,functions/*.js}"
}
