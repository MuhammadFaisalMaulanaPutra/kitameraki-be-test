{
  "name": "kitameraki-be-test",
  "version": "1.0.0",
  "description": "Task Management API — Azure Functions (v4) + Cosmos DB",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "setup:db": "node scripts/setup-cosmos.mjs",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@azure/cosmos": "^4.0.0",
    "@azure/functions": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.4"
  },
  "main": "dist/src/{index.js,functions/*.js}"
}
