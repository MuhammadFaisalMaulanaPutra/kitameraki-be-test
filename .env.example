# --- Server ---
NODE_ENV=development
PORT=7071
# Number of reverse proxies in front of the API (e.g. 1 behind nginx). 0 = none.
TRUST_PROXY=0

# --- Azure Cosmos DB ---
# Local emulator (docker compose). For Azure use your account endpoint/key from the portal.
COSMOS_ENDPOINT=http://localhost:8081
# Well-known emulator key (public, documented by Microsoft). NEVER commit a real key.
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE_ID=TaskApp
COSMOS_TASKS_CONTAINER_ID=Tasks
COSMOS_FORM_SETTINGS_CONTAINER_ID=FormSettings
# Must be false when the emulator is reached through a hostname other than localhost (e.g. docker service name).
COSMOS_ENABLE_ENDPOINT_DISCOVERY=false
# Create database/containers on startup when missing.
COSMOS_AUTO_CREATE_RESOURCES=true

# --- Azure Blob Storage (files of File picker values) ---
# Local Azurite emulator (docker compose). For Azure use the connection string of your storage account.
# Well-known Azurite dev account key (public, documented by Microsoft). NEVER commit a real key.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_FILES_CONTAINER=task-files
# Create the files container on startup when missing.
AZURE_STORAGE_AUTO_CREATE_CONTAINER=true
# Maximum upload size (5 MB).
FILE_MAX_SIZE_BYTES=5242880

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
JSON_BODY_LIMIT=100kb
